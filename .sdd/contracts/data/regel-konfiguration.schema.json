{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://konfiplaner.local/schemas/regeln.schema.json",
  "title": "Regel-Konfiguration",
  "description": "SPEC-0003 / CON-0007. YAML-Konfiguration der Restriktionen (als JSON validiert).",
  "type": "object",
  "required": [
    "restriktionen"
  ],
  "additionalProperties": false,
  "properties": {
    "restriktionen": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "typ": {
            "enum": [
              "hart",
              "weich",
              "aus"
            ]
          },
          "gewicht": {
            "type": "number",
            "exclusiveMinimum": 0,
            "default": 1
          },
          "parameter": {
            "type": "object"
          }
        },
        "required": [
          "typ"
        ]
      }
    }
  }
}
